{:paths ["src" "."]
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "72dde04b4c32854d70d17a670b277f8f7957a784"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint {:git/sha "5c9d4aea71d6caac529fffcf361aba0f87ee485e"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.4"}
        ;; 34767203 is a FLOOR: it is the first commit carrying
        ;; `manifest-without-self-cid` / `compute-manifest-cid` /
        ;; `manifest-integrity-error` in the portable kernel. This namespace
        ;; delegates to them, so an older pin does not weaken a check here --
        ;; it fails to load.
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "34767203dd67cee59f705f096278b9c831547b9d"}
        ;; Renamed upstream: kotoba-lang/dag-cbor is kotoba-lang/org-ietf-cbor.
        ;; The old name resolved only through GitHub's redirect, and a redirect
        ;; is not a dependency declaration -- it kept the build green while this
        ;; coordinate named no repository, which is why nothing noticed. The sha
        ;; does not move: 58144e81 is the same commit under either name, so the
        ;; classpath is unchanged; only the name is. It matters here because
        ;; tools.deps dedupes by the coordinate SYMBOL, so a closure that
        ;; reaches this repository under both spellings gets two cbor.core, at
        ;; two shas -- two answers to what the canonical bytes of a manifest
        ;; are, in the file that checks manifests against them.
        ;;
        ;; The :git/url is corrected and KEPT, not dropped. Dropping it and
        ;; letting io.github.<org>/<name> derive the URL is tempting -- it makes
        ;; the two impossible to disagree again -- but measured: it also removes
        ;; this dependency from what scripts/verify-repository-roles.cljs can
        ;; see. Its production-deps reads `(:git/url coordinate)` and keeps
        ;; nothing else, so a URL-less entry is not merely renamed there, it
        ;; disappears, and the :depends-on list in resources/repository-rules.edn
        ;; -- which that check asserts equal -- silently stops covering it.
        io.github.kotoba-lang/org-ietf-cbor
        {:git/url "https://github.com/kotoba-lang/org-ietf-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "310724803db65840f00d2d98d7887f2b6a512bd3"}
        ;; clojure.set replacement (stdlib substitution wave,
        ;; adr-2809061500-clojure-namespace-to-kotoba-stdlib): union/
        ;; intersection/difference/subset? -> kotoba.lang.coll's
        ;; set-union/set-intersection/set-difference/subset?.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/coll.git"
         :git/sha "9c223287998a59320f7b79a972c8198c14c6fab8"}
        ;; Replaces ad-hoc `clojure.edn` usage with the bounded, hardened EDN
        ;; reader (size/depth/node-count limits, dispatch forms forbidden).
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/edn.git"
         :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Hybrid KEM test-vector generation/verification (docs/hybrid-envelope-vectors.md).
  ;; Bouncy Castle is confined to this alias: the default paths and the
  ;; default :test alias stay BC-free (CI validates vector structure without BC).
  ;;   generate: kbb -M:vectors scripts/gen-hybrid-vectors.cljk
  ;;   verify:   kbb -M:vectors:vectors-test
  :vectors {:extra-paths ["test-vectors"]
            :extra-deps {org.bouncycastle/bcprov-jdk18on {:mvn/version "1.81"}}}
  :vectors-test {:extra-deps {io.github.cognitect-labs/test-runner
                              {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                 :main-opts ["-m" "cognitect.test-runner" "-d" "test-vectors"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
